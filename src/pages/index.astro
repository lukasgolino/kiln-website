---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Translate from "../components/Translate.astro";
import Styles from "../components/Styles.astro";
import Features from "../components/Features.astro";
import Compare from "../components/Compare.astro";
import Gallery from "../components/Gallery.astro";
import Install from "../components/Install.astro";
import OpenSource from "../components/OpenSource.astro";
import Faq from "../components/Faq.astro";
---

<Base
  title="KILN: smooth 3D game models, written as text by your AI agent"
  description="KILN is a free, open-source language for stylised 3D game models. Your AI agent writes shapes that blend like clay; KILN meshes, paints, rigs and animates them into glTF and Godot scenes, in a style you choose."
>
  <Hero />
  <Translate />
  <Styles />
  <Features />
  <Compare />
  <Gallery />
  <Install />
  <OpenSource />
  <Faq />
</Base>
